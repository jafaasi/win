{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "public": true,
  "rewrites": [
    {
      "source": "/api/state",
      "destination": "https://win-vlmx.onrender.com/api/state"
    },
    {
      "source": "/api/outcomes",
      "destination": "https://win-vlmx.onrender.com/api/outcomes"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://win-vlmx.onrender.com/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
